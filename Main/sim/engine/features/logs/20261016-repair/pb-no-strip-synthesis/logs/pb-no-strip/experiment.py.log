import os, sys, json, shutil
from pathlib import Path
repo=Path(r'E:\Workspace\Efinix')
sys.path.insert(0,str(repo/'Main/tools/check'))
import feature_build as fb, feature_synthesis as fs, feature_netlist as fn, validate
from check_run import Session, command, write_json
current=Session(profile='acceptance', input_patterns=validate.CHECKS['feature-synthesis']['inputs'])
print('RUN '+current.path.relative_to(repo).as_posix(),flush=True)
logs=current.logs('pb-no-strip'); tree=current.build('pb-no-strip')/'11011-111-d'
shutil.copyfile(__file__,logs/'experiment.py')
write_json(current.path/'plan.json',{'profile':'acceptance','checks':['pb-no-strip-synthesis'], 'scope':'supplemental explicit configuration; TEX=1 BAND_HW=1 STRIP=0 INST=1 PB=1'})
def perform():
    record=fb.build('11011-111-d',tree)
    assert not record['flags']['STRIP'] and record['flags']['PB']
    env=dict(os.environ)
    for key in ('EFINITY_HOME','PYTHONHOME','EFXPT_HOME','EFXPGM_HOME','EFXDBG_HOME','EFXIPM_HOME','EFXSVF_HOME','EFXSERDESDBG_HOME','EFINITY_USER_DIR_INI'): env.pop(key,None)
    fs.run_flow(tree,env)
    result=fs.collect(tree)
    assert fn.probe(fn.netlist(tree))=={'TEX':True,'BAND_HW':True,'INST':True,'PB':True}
    bit=tree/'fpga/gfx2d_ti60/outflow/gfx2d_ti60.bit'
    current.artifact(bit)
    shutil.copyfile(tree/'config.json',logs/'config.json')
    shutil.copyfile(tree/'flow.log',logs/'flow.log')
    for suffix in ('place.rpt','timing.rpt','warn.log'): shutil.copyfile(bit.parent/('gfx2d_ti60.'+suffix),logs/suffix)
    result.update({'config':record['config'],'caps':record['caps'],'tree':tree.relative_to(repo).as_posix(),'bit':bit.relative_to(repo).as_posix()})
    write_json(logs/'synthesis.json',result)
    return {'log':(logs/'flow.log').relative_to(repo).as_posix(),'scope':'PB without command-strip frontend'}
current.perform('check:pb-no-strip-synthesis',perform)
write_json(current.path/'result.json',{'status':'PASS','profile':'acceptance','checks':['pb-no-strip-synthesis'],'run_id':current.path.name})
print('PB NO STRIP SYNTHESIS PASS '+str(tree),flush=True)