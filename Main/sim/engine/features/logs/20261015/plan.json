{
  "profile": "quick",
  "scope": "engine optional-feature preliminary research",
  "checks": [
    "features.models",
    "features.blend-models",
    "features.synthesis",
    "features.board"
  ],
  "commands": [
    "WSL python3 Main/tools/check/research_engine_features.py --profile quick --models --prepare-synthesis --blend-models",
