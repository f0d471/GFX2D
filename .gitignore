# ---- 厂商资料包，不入库 ----
# 赛题指南、开发板资料、参考工程、TinyML 讲义等，共约 7GB，
# 著作权属于厂商与竞赛组织方，也不适合放进版本库。
# 仓库里的文档按 `Efinix/...` 引用它们，取用方式见 README.md「需要另外准备的东西」。
/Efinix/

# ---- Efinity 的编译输出与工作目录 ----
outflow/
work_syn/
work_pnr/
work_pt/
work_dbg/
*.vdb
*.map.v

# ---- 仿真产物 ----
*.wlf
transcript
vsim.dbg
*.mti

# ---- 程序构建目录 ----
# build/ 是默认值；build_inject / build_repro_* / build_dbg 等是各种变体，
# 全是编译产物，一律不入库（原来只忽略 build/，变体目录会被提交）。
build/
build_*/
build-*/

# ---- 板上串口日志 ----
# 证据日志只留「与当前产物对应」的那几份，放各程序的 logs/ 下（那个目录入库）；
# 散落在程序目录与构建目录里的一次性采集全部忽略。
Main/sw/apps/*/*/*.log
Main/sw/apps/*/*/*/*.log
!Main/sw/apps/*/*/logs/
!Main/sw/apps/*/*/logs/*.log

# ---- IDE 与编辑器缓存 ----
.metadata/
Thumbs.db
desktop.ini

# ---- Python 缓存 ----
# tools/ 下的脚本被 import 时（例如临时验证某个函数）会生成，
# 不是源码，不入库。
__pycache__/
*.pyc

# ---- 板上 Flash 整片备份 ----
# 每份 24MB，只留在本地用于恢复
Main/bit/flash_backup/
