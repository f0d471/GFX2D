+        board_puts("console fatal tasks\r\n");for(;;){}
     }
+    rtos_trap_install();vTaskStartScheduler();
+    for(;;){}
+}
+void vApplicationIdleHook(void) { ++s_idle; }
+void vApplicationMallocFailedHook(void)
+{
