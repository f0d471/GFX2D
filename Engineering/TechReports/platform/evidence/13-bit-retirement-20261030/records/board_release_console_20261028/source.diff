+    // row_mask：一拍四槽里哪些像素属于本行
+    function [3:0] row_mask;
+        input [1:0] lead;
+        input [10:0] pixels;
+        input [7:0] beat;
+        reg [11:0] first, limit, pos;
+        integer t;
