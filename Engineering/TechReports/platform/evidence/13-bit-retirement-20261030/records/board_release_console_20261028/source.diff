+        { ASSET_BULLET_PM_ENTRY,    SW6_SLOT_BULLET_PM },
+        { ASSET_BULLET_ST_ENTRY,    SW6_SLOT_BULLET_ST },
+        { ASSET_KEY_DEMO_ENTRY,     SW6_SLOT_KEY_DEMO },
+        { ASSET_SOLID8_ENTRY,       SW6_SLOT_SOLID8 },
